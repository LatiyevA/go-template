# Local Docker Compose values. Use localhost instead of db when running Go on the host.
SERVICE_NAME=go-template
HTTP_PORT=8080
HTTP_SHUTDOWN_TIMEOUT=10s
PG_URL=postgres://postgres:postgres@db:5432/app_db?sslmode=disable
PG_MAX_OPEN_CONNS=10
PG_MAX_IDLE_CONNS=2
PG_CONN_MAX_LIFETIME=30m
PG_CONN_MAX_IDLE_TIME=5m
PG_CONNECT_TIMEOUT=5s
MIGRATIONS_PATH=migrations
GIN_MODE=release
